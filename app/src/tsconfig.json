{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "types": ["react", "react-native", "vitest/globals"]
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
